generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbershop {
  id                   String                 @id @default(uuid())
  name                 String
  address              String
  description          String
  imageUrl             String?
  phones               String[]               @default([])
  managerId            String?                @unique
  closingTime          String?
  lunchEnd             String?
  lunchStart           String?
  openingTime          String?
  dailyGoal            Decimal                @default(500.00) @db.Decimal(10, 2)
  photos               String[]               @default([])
  latitude             Float?
  longitude            Float?
  isOpen               Boolean                @default(true)
  aboutUs              String?
  Barber               Barber[]
  // user relation removed
  BarbershopProduct    BarbershopProduct[]
  services             BarbershopService[]
  bookings             Booking[]
  FinancialTransaction FinancialTransaction[]
  StockItem            StockItem[]
  Style                Style[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  barbershopId String
  deletedAt    DateTime?
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model Booking {
  id             String            @id @default(uuid())
  stripeChargeId String?
  barbershopId   String
  serviceId      String
  userId         String
  date           DateTime          @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  barberId       String?
  Barber         Barber?           @relation(fields: [barberId], references: [id])
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // user relation removed
  userName       String?           // Denormalized user name for cross-db visibility
  // displayDate removed per user request to maintain db compatibility
  // cancelledBy removed per user request

}

model FinancialTransaction {
  id            String          @id
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  description   String
  category      String?
  paymentMethod PaymentMethod   @default(MONEY)
  date          DateTime        @default(now())
  barbershopId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  barberId      String?
  Barber        Barber?         @relation(fields: [barberId], references: [id])
  Barbershop    Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([date])
}

model StockItem {
  id           String     @id
  name         String
  quantity     Int        @default(0)
  minQuantity  Int        @default(5)
  unit         String     @default("un")
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Style {
  id           String     @id
  name         String
  imageUrl     String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Barber {
  id                   String                 @id
  name                 String
  email                String?
  phone                String?
  imageUrl             String?
  barbershopId         String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  Barbershop           Barbershop             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  Booking              Booking[]
  FinancialTransaction FinancialTransaction[]

  @@index([barbershopId])
}

model BarbershopProduct {
  id           String     @id
  name         String
  description  String?
  imageUrl     String?
  priceInCents Int
  quantity     Int        @default(0)
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

// Auth models moved to prisma/auth.prisma

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
