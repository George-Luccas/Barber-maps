generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth models removed - moved to separate auth.prisma

// Updated models to remove direct User relations
model Barbershop {
  id                   String                 @id @default(uuid())
  name                 String
  address              String
  latitude             Decimal?               @db.Decimal(10, 8)
  longitude            Decimal?               @db.Decimal(11, 8)
  description          String
  imageUrl             String?
  phones               String[]
  managerId            String?                @unique
  closingTime          String?
  lunchEnd             String?
  lunchStart           String?
  openingTime          String?
  dailyGoal            Decimal                @default(500.00) @db.Decimal(10, 2)
  photos               String[]               @default([])
  // User relation removed, managerId remains as foreign key ID only
  services             BarbershopService[]
  bookings             Booking[]
  FinancialTransaction FinancialTransaction[]
  StockItem            StockItem[]
  Style                Style[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  barbershopId String
  deletedAt    DateTime?
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model Booking {
  id             String            @id @default(uuid())
  stripeChargeId String?
  barbershopId   String
  serviceId      String
  userId         String
  date           DateTime          @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // User relation removed, userId remains as identifier
}

model Account {
    // Legacy model kept for now or should handle in auth schema?
    // User requested separate DB for Auth.
    // REMOVING from here entirely as it is in auth.prisma now.
    id String @id // Dummy to satisfy parser if needed, but better to remove.
}

// User, Session, Account, Verification removed. 


model FinancialTransaction {
  id            String          @id
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  description   String
  category      String?
  paymentMethod PaymentMethod   @default(MONEY)
  date          DateTime        @default(now())
  barbershopId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Barbershop    Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([date])
}

model StockItem {
  id           String     @id
  name         String
  quantity     Int        @default(0)
  minQuantity  Int        @default(5)
  unit         String     @default("un")
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Style {
  id           String     @id
  name         String
  imageUrl     String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}
