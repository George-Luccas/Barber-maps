generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth models removed - moved to separate auth.prisma

// Updated models to remove direct User relations
model Barbershop {
  id                   String                 @id @default(uuid())
  name                 String
  address              String
  latitude             Decimal?               @db.Decimal(10, 8)
  longitude            Decimal?               @db.Decimal(11, 8)
  description          String
  imageUrl             String?
  phones               String[]
  managerId            String?                @unique
  closingTime          String?
  lunchEnd             String?
  lunchStart           String?
  openingTime          String?
  isOpen               Boolean                @default(true)
  dailyGoal            Decimal                @default(500.00) @db.Decimal(10, 2)
  photos               String[]               @default([])
  // User relation removed, managerId remains as foreign key ID only
  services             BarbershopService[]
  bookings             Booking[]
  FinancialTransaction FinancialTransaction[]
  StockItem            StockItem[]
  Style                Style[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  barbershopId String
  deletedAt    DateTime?
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model Booking {
  id             String            @id @default(uuid())
  stripeChargeId String?
  barbershopId   String
  serviceId      String
  userId         String
  date           DateTime          @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // User relation removed: userId stores the ID from the Auth Database.
  // Foreign Key constraint is managed manually in application logic (data/bookings.ts).
}

// Merged Auth Models

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  password      String?
  phone         String?
  role          UserRole    @default(BARBER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  welcomeDiscountClaimed Boolean @default(false)
  welcomeDiscountUsed    Boolean @default(false)
  phoneExportedAt       DateTime?
  
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model FinancialTransaction {
  id            String          @id
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  description   String
  category      String?
  paymentMethod PaymentMethod   @default(MONEY)
  date          DateTime        @default(now())
  barbershopId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  Barbershop    Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([date])
}

model StockItem {
  id           String     @id
  name         String
  quantity     Int        @default(0)
  minQuantity  Int        @default(5)
  unit         String     @default("un")
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Style {
  id           String     @id
  name         String
  imageUrl     String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}
