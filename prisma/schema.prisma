generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barbershop {
  id                   String                 @id @default(uuid())
  name                 String
  address              String
  description          String
  imageUrl             String?
  phones               String[]               @default([])
  managerId            String?                @unique
  closingTime          String?
  lunchEnd             String?
  lunchStart           String?
  openingTime          String?
  dailyGoal            Decimal                @default(500.00) @db.Decimal(10, 2)
  photos               String[]               @default([])
  latitude             Float?
  longitude            Float?
  isOpen               Boolean                @default(true)
  city                 String?
  state                String?
  aboutUs              String?
  isSuspended          Boolean                @default(false)
  pixKey               String?                // Chave Pix dinâmica por barbearia
  Barber               Barber[]
  user                 user?                  @relation(fields: [managerId], references: [id])
  BarbershopProduct    BarbershopProduct[]
  services             BarbershopService[]
  bookings             Booking[]
  FinancialTransaction FinancialTransaction[]
  StockItem            StockItem[]
  Style                Style[]
  LoyaltyCards         LoyaltyCard[]
  favoritedBy          UserFavorite[]
  reviews              Review[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  priceInCents Int
  points       Int        @default(10) // New field for Loyalty 2.0
  barbershopId String
  deletedAt    DateTime?
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  bookings     Booking[]
}

model Booking {
  id             String            @id @default(uuid())
  stripeChargeId String?
  barbershopId   String
  serviceId      String
  userId         String
  status         BookingStatus     @default(CONFIRMED)
  receiptUrl     String?
  date           DateTime          @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  barberId       String?
  userName       String?
  isSubscription Boolean           @default(false)
  isWelcomeDiscount Boolean        @default(false)
  Barber         Barber?           @relation(fields: [barberId], references: [id])
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  service        BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  UsageLog       UsageLog?
}

model FinancialTransaction {
  id            String          @id
  type          TransactionType
  amount        Decimal         @db.Decimal(10, 2)
  description   String
  category      String?
  paymentMethod PaymentMethod   @default(MONEY)
  date          DateTime        @default(now())
  barbershopId  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  barberId      String?
  Barber        Barber?         @relation(fields: [barberId], references: [id])
  Barbershop    Barbershop      @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
  @@index([date])
}

model StockItem {
  id           String     @id
  name         String
  quantity     Int        @default(0)
  minQuantity  Int        @default(5)
  unit         String     @default("un")
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Style {
  id           String     @id
  name         String
  imageUrl     String
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Barber {
  id                   String                 @id
  name                 String
  email                String?
  phone                String?
  imageUrl             String?
  instagram            String?
  barbershopId         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  Barbershop           Barbershop?             @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  Booking              Booking[]
  FinancialTransaction FinancialTransaction[]
  reviews              Review[]

  @@index([barbershopId])
}

model BarbershopProduct {
  id           String     @id
  name         String
  description  String?
  imageUrl     String?
  priceInCents Int
  quantity     Int        @default(0)
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  price         Decimal        @db.Decimal(10, 2)
  service_limit Int
  description   String?
  stripePriceId String?
  Subscription  Subscription[]
}

model Subscription {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  planId                  String
  status                  SubscriptionStatus @default(ACTIVE)
  current_balance         Int
  next_billing_date       DateTime           @db.Timestamptz(6)
  gateway_subscription_id String?
  createdAt               DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @db.Timestamptz(6)
  Plan                    Plan               @relation(fields: [planId], references: [id])
  UsageLog                UsageLog[]
}

model UsageLog {
  id             String       @id @default(uuid())
  subscriptionId String
  bookingId      String       @unique
  date_used      DateTime     @default(now()) @db.Timestamptz(6)
  Booking        Booking      @relation(fields: [bookingId], references: [id])
  Subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model user {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  coverImage    String?
  password      String?
  phone         String?
  role          UserRole    @default(BARBER)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  welcomeDiscountClaimed Boolean @default(false)
  welcomeDiscountUsed    Boolean @default(false)
  phoneExportedAt       DateTime?

  imagePosition         String   @default("center")
  coverImagePosition    String   @default("center")
  
  accounts      Account[]
  sessions      Session[]
  
  Barbershop    Barbershop?
  PlatformFeedback PlatformFeedback[]
  LoyaltyCards     LoyaltyCard[]
  favorites        UserFavorite[]
  reviews          Review[]

  @@map("user") // Optional: map to "user" table if you want to keep lowercase table names like in auth.prisma, or stick to default. Auth prisma used @@map("user"). Let's keep it consistent if possible, though strict PascalCase is standard in Prisma. The auth.prisma had @@map("user"). schema.prisma has model user (lowercase). Let's keep model user as is but ensure relationships are correct.
}

model UserFavorite {
  userId       String
  barbershopId String
  createdAt    DateTime   @default(now())
  user         user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@id([userId, barbershopId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum PaymentMethod {
  MONEY
  CARD
  PIX
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum UserRole {
  CLIENT
  BARBER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Promotion {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  linkUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformFeedback {
  id        String       @id @default(uuid())
  userId    String?
  type      FeedbackType @default(OTHER)
  message   String
  createdAt DateTime     @default(now())
  user      user?        @relation(fields: [userId], references: [id])
}

enum FeedbackType {
  BUG
  SUGGESTION
  COMPLAIMENT
  OTHER
}


enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
}

model LoyaltyCard {
  id                String      @id @default(uuid())
  userId            String
  barbershopId      String
  completedCuts     Int         @default(0) // Deprecated: Will be migrated to currentPoints
  currentPoints     Int         @default(0) // New: Points progress (Target 100)
  totalLifetimePoints Int       @default(0) // New: Total points ever earned
  freeCuts          Int         @default(0)
  tier              LoyaltyTier @default(BRONZE)
  createdAt         DateTime    @default(now())
  updatedAt     DateTime   @updatedAt
  
  user       user       @relation(fields: [userId], references: [id])
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  
  @@unique([userId, barbershopId])
}


model Review {
  id           String     @id @default(uuid())
  rating       Int
  comment      String?
  userId       String
  barbershopId String?
  barberId     String? // New optional field
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  user         user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barber       Barber?    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  // Combined index for unique review per user per entity?
  // Existing: @@unique([userId, barbershopId]) but this might block reviewing a barber if user reviewed shop?
  // Or block multiples? Let's relax unique constraint or make it compound.
  // Actually, existing schema has @@unique([userId, barbershopId]).
  // If I add barberId, I should probably remove that unique constraint or update it.
  // BUT modifying constraints can be tricky.
  // User wants "Review per Barber".
  // So a user should be able to review Barber A in Shop X, and also review Shop X? 
  // Let's assume unique constraint should be loosened or updated.
  // I'll comment out the @@unique for now to avoid migration issues if possible, or replace with @@unique([userId, barbershopId, barberId])? No, barberId is optional.
  // Let's start by just adding the fields and relations.
  
  @@index([barbershopId])
  @@index([userId])
  @@index([barberId])
}
